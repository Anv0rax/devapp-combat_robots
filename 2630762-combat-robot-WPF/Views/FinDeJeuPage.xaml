<Page x:Class="_2630762_combat_robot_wpf.Views.FinDeJeuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_2630762_combat_robot_wpf.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Combat de robots - Fin de partie">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Page.Resources>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >

        <TextBlock Text="{Binding Titre}" FontSize="48" FontWeight="DemiBold"
                   Foreground="{Binding CouleurTitre}" HorizontalAlignment="Center" />

        <TextBlock Text="{Binding SousTitre}" FontSize="18" Foreground="#666666"
                   HorizontalAlignment="Center" Margin="0, 8, 0, 32" />

        <StackPanel Visibility="{Binding EstClient, Converter={StaticResource BoolVis}}">
            <Button Content="Rejouer" Height="38" FontSize="18" Margin="0, 4"
                    Click="Rejouer_Button_Click" IsEnabled="{Binding ChoixActif}" />
            <Button Content="Quitter" Height="38" FontSize="18" Margin="0, 4"
                    Click="Quitter_Button_Click" IsEnabled="{Binding ChoixActif}" />
        </StackPanel>

        <StackPanel Visibility="{Binding EstServeur, Converter={StaticResource BoolVis}}">
            <TextBlock Text="En attente du choix du client..." FontSize="16"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{Binding ErreurMessage}" FontSize="14" Foreground="Red"
                   HorizontalAlignment="Center" Margin="0, 16,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Page>
