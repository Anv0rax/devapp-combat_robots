<Page x:Class="_2630762_combat_robot_wpf.Views.ConfigRobotPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_2630762_combat_robot_wpf.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Combat de robots - Configuration">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="32" FontWeight="DemiBold">Configurez votre robot</TextBlock>
            <TextBlock HorizontalAlignment="Center" FontSize="24" >Répartissez vos 10 points</TextBlock>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <TextBlock TextAlignment="Center" FontSize="20">
                        Vie
                    </TextBlock>
                    <TextBox TextAlignment="Center" FontSize="30" Width="80" Text="{Binding VieInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <TextBlock TextAlignment="Center" FontSize="20">
                        Armure
                    </TextBlock>
                    <TextBox TextAlignment="Center" FontSize="30" Width="80"  Text="{Binding ArmureInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <TextBlock TextAlignment="Center"  FontSize="20">
                        Degats
                    </TextBlock>
                    <TextBox TextAlignment="Center" FontSize="30" Width="80" Text="{Binding DegatsInput, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
            <Button Height="30" FontSize="18" Click="ConfirmRobot_Button_Click">Confirmer</Button>
            <TextBlock HorizontalAlignment="Center" FontSize="16"
                   Foreground="Red" Text="{Binding ErreurMessage, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </Grid>
</Page>
