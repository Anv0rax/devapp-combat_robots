<Page x:Class="_2630762_combat_robot_wpf.Views.AccueilClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_2630762_combat_robot_wpf.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Combat de robots - Rejoindre">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="0.5*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="8*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Accueil_Button_Click">X</Button>
        
        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold">
            Rejoindre une partie
        </TextBlock>

        <StackPanel Grid.Column="1" Grid.Row="2" Margin="20" VerticalAlignment="Center" >

            <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,5,0,5" VerticalAlignment="Center" >
                <TextBlock Text="Votre pseudo :" FontSize="24" FontWeight="DemiBold"/>
                <TextBox Grid.Column="2" FontSize="24" Text="{Binding NomInput, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,5,0,5" VerticalAlignment="Center" >
                <TextBlock Text="IP de la partie :" FontSize="24" FontWeight="DemiBold" />
                <TextBox Grid.Column="2" FontSize="24" Text="{Binding IpInput, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,5,0,5" VerticalAlignment="Center" >
                <TextBlock Text="Port :" FontSize="24" FontWeight="DemiBold" />
                <TextBox Grid.Column="2" FontSize="24" Text="{Binding IntInput, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </StackPanel>
        </StackPanel>
        <Button Grid.Row="3" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                Margin="50,20" Click="Rejoindre_Button_Click" FontSize="20" FontWeight="DemiBold" 
                Content="{Binding TexteBoutonRejoindre, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                   Foreground="Red" Text="{Binding ErreurMessage, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</Page>
